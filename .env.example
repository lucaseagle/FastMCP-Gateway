# Local demo: use `uv run fastmcp-gateway init` to generate a unique token.
# Production environment example; replace these values in your secret/config manager.
GATEWAY_MODE=production
GATEWAY_CONFIG=config/local.toml
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_JWKS_URI=https://identity.corp.example/.well-known/jwks.json
GATEWAY_ISSUER=https://identity.corp.example
GATEWAY_AUDIENCE=fastmcp-gateway
GATEWAY_ALLOWED_HOSTS=["gateway.corp.example","localhost","127.0.0.1"]
GATEWAY_ALLOWED_ORIGINS=[]
# Optional; disabled when unset. A trusted collector inside your network.
# GATEWAY_OTLP_ENDPOINT=http://otel-collector:4318
# Inject upstream credentials through a secret manager; do not commit values.
# INVENTORY_AUTHORIZATION=Bearer <injected-at-runtime>
